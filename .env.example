# Dish360 — copy to .env.local and fill in what you need.
#
# Everything here is optional for local development. `npm run dev` works with
# none of it: the app seeds a JSON file under .data/ and builds 3D models
# itself. These are the connections to the outside world.
#
# .env.local is gitignored. Keep it that way — the service role key below is a
# full-access credential, and this repository is public.


# ---------------------------------------------------------------- database ---
# Needed to deploy. Without them a production request fails loudly rather than
# writing to a disk that will not survive it.
#
# Both come from the Supabase dashboard, Project Settings → API. Run
# supabase/migrations/0001_dish360.sql against the project first, then check it
# with /api/db-check?write=1 while signed in as an owner.
#
# SUPABASE_SERVICE_ROLE_KEY has no NEXT_PUBLIC_ prefix on purpose: Next inlines
# any NEXT_PUBLIC_ variable into the browser bundle, and this key bypasses every
# row-level policy. Never prefix it, and never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Forces a backend instead of picking one from the keys above.
#   local      the JSON file under .data/ — also the opt-in that lets a VPS or
#              a container with a real persistent disk serve production from it
#   supabase   insist on Supabase, and fail if it is not reachable
# DATA_BACKEND=

# Read by the browser, so these two are safe to publish. Only the guest-facing
# client would use them; the server uses the service role key above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -------------------------------------------------------------- sessions ---
# Signs the session cookie. Set this before deploying anywhere: without it the
# cookie is signed with a fallback that is written down in lib/auth/session.ts,
# which means anyone can forge one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=


# ------------------------------------------------------------------ the 3D ---
# Leave unset to build models here, from the dish record, with no external call.
# Set both to build them from the uploaded photographs instead. If the service
# is unreachable the built-in builder takes over rather than leaving a dish with
# no model.
# MODEL_PROVIDER=3daistudio
# THREE_D_AI_STUDIO_API_KEY=


# ------------------------------------------------------------------- misc ---
# The public origin, used in the table-code URLs that get printed. Worked out
# from the request when unset, which is right unless you print codes from one
# host and serve them from another.
# NEXT_PUBLIC_SITE_URL=https://dish360.in
